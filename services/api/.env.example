# PostgreSQL connection string (SQLAlchemy 2.x + psycopg3 driver)
DATABASE_URL=postgresql+psycopg://postgres:<PASSWORD>@localhost:5432/setuvyuha

# Runtime environment: development | testing | production
APP_ENV=development

# Echo SQLAlchemy SQL statements (true | false)
SQL_ECHO=false

# Feed staleness threshold in seconds
FEED_STALE_THRESHOLD_SECONDS=60
