# FastAPI backend base URL (coordinated with P2)
# NOTE: On a physical phone, "localhost" refers to the phone itself.
# Copy to .env.local (gitignored) and set your laptop's active Wi-Fi IPv4, e.g.:
# EXPO_PUBLIC_API_BASE_URL=http://10.10.10.36:8000
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to true only if you want to allow Development Mode login in non-__DEV__ builds
EXPO_PUBLIC_ENABLE_DEV_MODE=false
