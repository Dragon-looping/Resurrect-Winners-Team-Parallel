# --- AI Gateway (Person 4 - Branch 1) ---
# Obtain Groq key from https://console.groq.com/keys
GROQ_API_KEY=
# Recommended example: llama-3.3-70b-versatile (must be set explicitly)
GROQ_MODEL=

# Obtain Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Recommended example: gemini-2.5-flash (must be set explicitly)
GEMINI_MODEL=

# Primary provider: groq | gemini
AI_PRIMARY_PROVIDER=groq
# Maximum overall gateway request deadline in seconds (capped at 10)
AI_REQUEST_TIMEOUT=10
# Maximum single provider attempt timeout in seconds (capped at 4)
AI_PROVIDER_TIMEOUT=4
# Default cooldown duration in seconds after provider failure
AI_PROVIDER_COOLDOWN_SECONDS=30
